{
  "id": "corrective_maintenance",
  "name": "Corrective Maintenance Report",
  "system_type": "fire_alarm",
  "job_type": "reactive_callout",
  "version": 2,
  "sections": [
    {
      "id": "call_details",
      "title": "Call Details",
      "fields": [
        { "id": "site_name_address", "type": "text", "label": "Site name & address", "prefill": "site" },
        { "id": "date", "type": "text", "label": "Date", "prefill": "date" },
        { "id": "call_no", "type": "text", "label": "Call No", "prefill": "call_no" },
        { "id": "client_no", "type": "text", "label": "Client No", "prefill": "client_no" },
        {
          "id": "job_type_radio",
          "type": "select",
          "label": "Job type",
          "options": ["Maintenance", "Repairs", "Call out"],
          "prefill": "visit_type"
        }
      ]
    },
    {
      "id": "reported_fault",
      "title": "Reported Fault",
      "fields": [
        {
          "id": "reported_fault",
          "type": "longtext",
          "label": "Reported fault",
          "required": true,
          "prefill": "reported_fault"
        },
        { "id": "device_no", "type": "text", "label": "Device No" },
        { "id": "device_location", "type": "text", "label": "Device Location" },
        { "id": "device_type", "type": "text", "label": "Device type" }
      ]
    },
    {
      "id": "signalling_type",
      "title": "Signalling",
      "fields": [
        {
          "id": "signalling_type",
          "type": "select",
          "label": "Type of signalling",
          "options": ["Digital Com", "Redcare", "BT complete", "Audible", "Adpro", "Other"]
        },
        {
          "id": "cause",
          "type": "select",
          "label": "Fault cause",
          "options": ["Customer related", "Company related", "Line fault related", "Other"]
        }
      ]
    },
    {
      "id": "action_taken",
      "title": "Action Taken",
      "fields": [
        {
          "id": "action_taken",
          "type": "longtext",
          "label": "Action taken / remedy",
          "required": true
        }
      ]
    },
    {
      "id": "equipment_removed",
      "title": "Equipment Removed From Site",
      "repeatable": true,
      "repeat_label": "Item",
      "fields": [
        { "id": "equip_type", "type": "text", "label": "Type" },
        { "id": "equip_make_model", "type": "text", "label": "Make / Model" },
        { "id": "equip_serial_no", "type": "text", "label": "Serial No" },
        { "id": "temp_fitted", "type": "yes_no_na", "label": "Temp fitted" },
        { "id": "temp_serial_no", "type": "text", "label": "Temp Serial No" }
      ]
    },
    {
      "id": "materials_used",
      "title": "Materials Used",
      "repeatable": true,
      "repeat_label": "Material",
      "fields": [
        { "id": "material_description", "type": "text", "label": "Description" },
        { "id": "material_qty", "type": "number", "label": "Qty" }
      ]
    },
    {
      "id": "further_action",
      "title": "Further Action Required",
      "fields": [
        { "id": "further_action_required", "type": "longtext", "label": "Further action required" }
      ]
    },
    {
      "id": "time_further_action",
      "title": "Times",
      "fields": [
        { "id": "travel_time", "type": "text", "label": "Travel time", "prefill": "travel_time" },
        { "id": "time_arrival", "type": "text", "label": "Time arrival (HH:MM)", "prefill": "arrival_time" },
        { "id": "time_depart", "type": "text", "label": "Time depart (HH:MM)", "hint": "Filled in when you submit if left blank", "prefill": "departure_time" },
        { "id": "time_on_site", "type": "text", "label": "Time taken", "hint": "Worked out when you submit if left blank", "prefill": "time_taken" }
      ]
    },
    {
      "id": "system_status",
      "title": "System Status",
      "fields": [
        {
          "id": "system_operational",
          "type": "yes_no_na",
          "label": "System left in full working order",
          "required": true,
          "triggers_remedial": true,
          "remedialOn": "no",
          "remedial_priority": "urgent"
        },
        {
          "id": "disconnections",
          "type": "longtext",
          "label": "Items and/or disconnections not in working order",
          "hint": "Leave blank if the system is fully working"
        }
      ]
    },
    {
      "id": "sign_off",
      "title": "Sign-Off",
      "fields": [
        { "id": "engineer_name", "type": "text", "label": "Engineer Name", "prefill": "engineer_name" },
        { "id": "engineer_signature", "type": "signature", "label": "Engineer Signature", "required": true },
        { "id": "customer_name", "type": "text", "label": "Customer Name" },
        { "id": "customer_signature", "type": "signature", "label": "Customer Signature" },
        { "id": "sign_date", "type": "text", "label": "Date", "prefill": "date" }
      ]
    }
  ]
}
