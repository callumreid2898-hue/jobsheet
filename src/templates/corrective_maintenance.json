{
  "id": "corrective_maintenance",
  "name": "Corrective Maintenance Report",
  "system_type": "fire_alarm",
  "job_type": "reactive_callout",
  "version": 1,
  "sections": [
    {
      "id": "call_details",
      "title": "Call Details",
      "fields": [
        { "id": "date", "type": "text", "label": "Date" },
        { "id": "call_no", "type": "text", "label": "Call No" },
        { "id": "client_no", "type": "text", "label": "Client No" },
        {
          "id": "job_type_radio",
          "type": "select",
          "label": "Job type",
          "options": ["Maintenance", "Repairs", "Call out"]
        }
      ]
    },
    {
      "id": "reported_fault",
      "title": "Reported Fault",
      "fields": [
        {
          "id": "reported_fault",
          "type": "longtext",
          "label": "Reported fault description",
          "required": true
        },
        { "id": "device_no", "type": "text", "label": "Device No" },
        { "id": "device_location", "type": "text", "label": "Device Location" },
        { "id": "device_type", "type": "text", "label": "Device type" }
      ]
    },
    {
      "id": "signalling_type",
      "title": "Signalling Type",
      "fields": [
        {
          "id": "signalling_type",
          "type": "select",
          "label": "Type of signalling",
          "options": [
            "Digital Com",
            "Audible",
            "Customer related",
            "Company related",
            "Redcare",
            "Adpro",
            "Line fault related",
            "Other"
          ]
        },
        {
          "id": "cause",
          "type": "select",
          "label": "Fault cause",
          "options": [
            "Customer related",
            "Company related",
            "Line fault related",
            "Other"
          ]
        }
      ]
    },
    {
      "id": "action_taken",
      "title": "Action Taken",
      "fields": [
        {
          "id": "action_taken",
          "type": "longtext",
          "label": "Action taken / remedy",
          "required": true
        }
      ]
    },
    {
      "id": "equipment_removed",
      "title": "Equipment Removed",
      "repeatable": true,
      "repeat_label": "Item",
      "fields": [
        { "id": "equip_type", "type": "text", "label": "Type" },
        { "id": "equip_make_model", "type": "text", "label": "Make / Model" },
        { "id": "equip_serial_no", "type": "text", "label": "Serial No" },
        { "id": "temp_fitted", "type": "yes_no_na", "label": "Temp fitted" },
        { "id": "temp_serial_no", "type": "text", "label": "Temp Serial No" }
      ]
    },
    {
      "id": "materials_used",
      "title": "Materials Used",
      "repeatable": true,
      "repeat_label": "Material",
      "fields": [
        { "id": "material_description", "type": "text", "label": "Description", "required": true },
        { "id": "material_qty", "type": "number", "label": "Qty" }
      ]
    },
    {
      "id": "time_further_action",
      "title": "Time & Further Action",
      "fields": [
        { "id": "travel_time", "type": "text", "label": "Travel time (hrs)" },
        { "id": "time_on_site", "type": "text", "label": "Time on site (hrs)" },
        { "id": "further_action_required", "type": "longtext", "label": "Further action required" },
        {
          "id": "system_operational",
          "type": "yes_no_na",
          "label": "System left operational",
          "required": true,
          "triggers_remedial": true,
          "remedialOn": "no",
          "remedial_priority": "urgent"
        }
      ]
    },
    {
      "id": "sign_off",
      "title": "Sign-Off",
      "fields": [
        { "id": "engineer_name", "type": "text", "label": "Engineer Name" },
        { "id": "engineer_signature", "type": "signature", "label": "Engineer Signature", "required": true },
        { "id": "customer_name", "type": "text", "label": "Customer Name" },
        { "id": "customer_signature", "type": "signature", "label": "Customer Signature" },
        { "id": "sign_date", "type": "text", "label": "Date" }
      ]
    }
  ]
}
